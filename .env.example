# System One server. Ollama (>= 0.35.1) by default; llama.cpp would be http://127.0.0.1:8080/v1/systemone
SYSTEMONE_URL=http://127.0.0.1:11434/v1/systemone
SYSTEMONE_MODEL=clef-flash
# Only for hosted endpoints (Workers AI / TypeSafe)
SYSTEMONE_API_KEY=

# IMAP mailbox (for Gmail: an app password, not your account password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX=INBOX
IMAP_ROOT_FOLDER=Clef
# folders | labels (Gmail) | none
TRIAGE_TARGET=labels
